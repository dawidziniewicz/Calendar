# Wspólny sekret między Cloudflare Pages (funkcja proxy) a tym serwerem.
# Wygeneruj: openssl rand -hex 32
API_KEY=zmien-mnie
PORT=8787
DB_PATH=./data/kalendarz.sqlite
# Co ile minut pobierać kalendarze iCal (Booking, Airbnb...)
SYNC_INTERVAL_MINUTES=15
TZ=Europe/Warsaw

# Token tunelu z panelu Cloudflare: Zero Trust → Networks → Tunnels → (tunel) → Docker
TUNNEL_TOKEN=

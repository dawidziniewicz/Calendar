# Wspólny sekret między Cloudflare Pages (funkcja proxy) a tym serwerem.
# Wygeneruj: openssl rand -hex 32
API_KEY=zmien-mnie
PORT=8787
DB_PATH=./data/kalendarz.sqlite
# Co ile minut pobierać kalendarze iCal (Booking, Airbnb...)
SYNC_INTERVAL_MINUTES=15
TZ=Europe/Warsaw

# Token tunelu z panelu Cloudflare: Zero Trust → Networks → Tunnels → (tunel) → Docker
TUNNEL_TOKEN=

# ---- Strona www i e-maile (zapytania o rezerwację) ----
# Adres aplikacji kalendarza i strony — do linków w e-mailach
APP_URL=https://kalendarz.odmorzadogor.pl
SITE_URL=https://odmorzadogor.pl
# Gdzie wysyłać powiadomienia o nowych zapytaniach (można potem zmienić w aplikacji: Ustawienia → Powiadomienia e-mail)
ADMIN_EMAIL=kontakt@odmorzadogor.pl
# Nadawca e-maili do gości (domena musi być zweryfikowana u dostawcy)
MAIL_FROM=Od Morza do Gór <rezerwacje@odmorzadogor.pl>

# Wariant A — Resend (resend.com, darmowe 3000 e-maili/mies.): wystarczy klucz API
RESEND_API_KEY=
# Wariant B — własna skrzynka SMTP (np. kontakt@odmorzadogor.pl u hostingodawcy). Używane, gdy RESEND_API_KEY jest pusty.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
